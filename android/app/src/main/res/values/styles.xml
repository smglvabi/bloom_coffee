<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bloom keeps its warm light palette even when the system uses dark mode. -->
    <style name="BloomBaseTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorBackground">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="LaunchTheme" parent="BloomBaseTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="BloomBaseTheme" />
</resources>
